# PostHog project API key — the public key used by the JS SDK. Find it at:
# https://app.posthog.com/project/settings
# If this is absent the middleware silently no-ops: nothing breaks, no events flow.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingestion host. Use:
#   https://us.i.posthog.com   — PostHog US cloud
#   https://eu.i.posthog.com   — PostHog EU cloud
#   https://svc.yoursite.com   — your own reverse-proxy (dodges ad-blockers)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Secret used to key the anonymous distinctId HMAC. Generate one with:
#   openssl rand -hex 32
# Without it each edge instance keys differently, so repeat visits from the same
# agent stop collapsing into one visitor. Treat it like any other secret: the
# user agent ships in the clear on the same event, so publishing this makes the
# id reversible back to the client IP by brute force.
AGENT_ANALYTICS_ID_SECRET=

# Absolute origin of your deployment, used to build the synthesized Markdown
# pointer documents for paths that have no mirror. Defaults to
# http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
